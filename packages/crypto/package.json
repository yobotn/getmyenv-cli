{
  "name": "@getmyenv/crypto",
  "version": "0.6.3",
  "description": "Encryption for getmyenv: Argon2id-wrapped X25519 keys, sealed per-context keys, AES-256-GCM values",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "homepage": "https://getmyenv.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yobotn/getmyenv-cli.git",
    "directory": "packages/crypto"
  },
  "bugs": {
    "url": "https://getmyenv.com/contact",
    "email": "hello@getmyenv.com"
  },
  "keywords": [
    "getmyenv",
    "encryption",
    "e2ee",
    "x25519",
    "aes-256-gcm",
    "argon2id",
    "secrets",
    "environment-variables"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "hash-wasm": "^4.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24"
  }
}
